import QtQuick
import QtQuick.Controls.Basic

Item {
    id: root

    property var controller

    implicitHeight: 620

    Rectangle {
        anchors.fill: parent

        radius: 10

        color: "#e9e9e9"

        border.width: 1
        border.color: "#d4d4d4"

        Column {
            anchors.fill: parent

            anchors.margins: 12

            spacing: 8

            // =====================================================
            // Album header
            // =====================================================

            Row {
                width: parent.width

                spacing: 10

                Label {
                    text:
                            root.controller !== null &&
                        root.controller.currentAlbumTitle.length > 0
                        ? root.controller.currentAlbumTitle
                        : qsTr("Альбом")

                    color: "#202020"

                    font.pixelSize: 18
                    font.bold: true

                    elide:
                        Text.ElideRight

                    width:
                        parent.width -
                        trackCountLabel.width -
                        10

                    anchors.verticalCenter:
                        parent.verticalCenter
                }

                Label {
                    id: trackCountLabel

                    text:
                            root.controller !== null &&
                        root.controller.currentAlbumTrackCount > 0
                        ? root.controller.currentAlbumTrackCount +
                        qsTr(" треков")
                        : ""

                    color: "#666666"

                    anchors.verticalCenter:
                        parent.verticalCenter
                }
            }

            // =====================================================
            // Album artwork
            // =====================================================

            Row {
                width: parent.width

                height: 96

                spacing: 12

                visible:
                    root.controller !== null &&
                    root.controller.currentAlbumCoverUri.length > 0

                Image {
                    id: albumCover

                    width: 96
                    height: 96

                    source:
                            root.controller !== null &&
                        root.controller.currentAlbumCoverUri.length > 0
                        ? "image://yandex/" +
                        root.controller.currentAlbumCoverUri
                        : ""

                    fillMode:
                        Image.PreserveAspectCrop

                    asynchronous: true
                    cache: true

                    Rectangle {
                        anchors.fill: parent

                        radius: 8

                        color: "#d0d0d0"

                        visible:
                            albumCover.status !== Image.Ready

                        Label {
                            anchors.centerIn: parent

                            text: "♪"

                            color: "#666666"

                            font.pixelSize: 28
                        }
                    }
                }
            }

            // =====================================================
            // Album tracks
            // =====================================================

            ListView {
                id: tracksView

                width: parent.width

                height:
                    parent.height -
                    (
                            root.controller !== null &&
                            root.controller.currentAlbumCoverUri.length > 0
                            ? 151
                            : 45
                    )

                model:
                        root.controller !== null
                    ? root.controller.albumModel
                    : null

                clip: true

                spacing: 6

                boundsBehavior:
                    Flickable.StopAtBounds

                ScrollBar.vertical:
                    ScrollBar {
                        policy:
                                tracksView.contentHeight >
                            tracksView.height
                            ? ScrollBar.AsNeeded
                            : ScrollBar.AlwaysOff
                    }

                delegate: Rectangle {
                    id: trackDelegate

                    required property int index

                    required property string trackId
                    required property string title
                    required property string artist
                    required property string artistId
                     required property string coverUri
                    required property int durationMs

                    width:
                        tracksView.width -
                        (
                            tracksView.ScrollBar.vertical.visible
                                ? 10
                                : 0
                        )

                    height: 68

                    radius: 8

                    color:
                        rowMouseArea.containsMouse
                            ? "#dcdcdc"
                            : "#f2f2f2"

                    border.width: 1

                    border.color:
                        rowMouseArea.containsMouse
                            ? "#c4c4c4"
                            : "#e0e0e0"

                    // -------------------------------------------------
                    // Track artwork
                    // -------------------------------------------------

                    Image {
                        id: cover

                        anchors.left:
                            parent.left

                        anchors.leftMargin:
                            8

                        anchors.verticalCenter:
                            parent.verticalCenter

                        width: 52
                        height: 52

                        source:
                                coverUri.length > 0
                            ? "image://yandex/" +
                            coverUri
                            : ""

                        fillMode:
                            Image.PreserveAspectCrop

                        asynchronous: true
                        cache: true

                        Rectangle {
                            anchors.fill:
                                parent

                            radius: 4

                            color: "#d0d0d0"

                            visible:
                                cover.status !== Image.Ready

                            Label {
                                anchors.centerIn:
                                    parent

                                text: "♪"

                                color: "#666666"

                                font.pixelSize: 20
                            }
                        }
                    }

                    // -------------------------------------------------
                    // Track information
                    // -------------------------------------------------

                    Column {
                        id: trackInfo

                        anchors.left:
                            cover.right

                        anchors.leftMargin:
                            12

                        anchors.right:
                            durationLabel.left

                        anchors.rightMargin:
                            12

                        anchors.verticalCenter:
                            parent.verticalCenter

                        spacing:
                            2

                        Label {
                            width:
                                parent.width

                            text:
                                    title.length > 0
                                ? title
                                : qsTr("Без названия")

                            color:
                                "#202020"

                            font.pixelSize:
                                14

                            font.bold:
                                true

                            elide:
                                Text.ElideRight
                        }

                        Item {
                            id: artistArea

                            width:
                                parent.width

                            height:
                                18
                        }

                        Label {
                            width:
                                parent.width

                            text:
                                root.controller.currentAlbumTitle

                            color:
                                "#777777"

                            font.pixelSize:
                                10

                            elide:
                                Text.ElideRight
                        }
                    }

                    // -------------------------------------------------
                    // Duration
                    // -------------------------------------------------

                    Label {
                        id: durationLabel

                        anchors.right:
                            parent.right

                        anchors.rightMargin:
                            14

                        anchors.verticalCenter:
                            parent.verticalCenter

                        text:
                            root.formatDuration(
                                durationMs
                            )

                        color:
                            "#555555"

                        font.pixelSize:
                            11
                    }

                    // -------------------------------------------------
                    // Play track
                    // -------------------------------------------------

                    MouseArea {
                        id: rowMouseArea

                        anchors.fill:
                            parent

                        hoverEnabled:
                            true

                        cursorShape:
                            Qt.PointingHandCursor

                        z:
                            0

                        onClicked: {
                            if (
                                root.controller !== null
                            ) {
                                root.controller
                                    .selectAlbumTrack(
                                    index
                                )
                            }
                        }
                    }

                    // -------------------------------------------------
                    // Artist link
                    // -------------------------------------------------

                    MouseArea {
                        id: artistMouseArea

                        x:
                            trackInfo.x

                        y:
                            trackInfo.y +
                            artistArea.y

                        width:
                            trackInfo.width

                        height:
                            artistArea.height

                        z:
                            10

                        enabled:
                            artistId.length > 0

                        hoverEnabled:
                            true

                        cursorShape:
                            enabled
                                ? Qt.PointingHandCursor
                                : Qt.ArrowCursor

                        onClicked: {
                            if (
                                root.controller !== null &&
                                artistId.length > 0
                            ) {
                                root.controller
                                    .loadArtist(
                                    artistId
                                )
                            }
                        }

                        Label {
                            anchors.fill:
                                parent

                            text:
                                artist

                            color:
                                artistMouseArea.containsMouse
                                    ? "#2468d7"
                                    : "#555555"

                            font.pixelSize:
                                12

                            elide:
                                Text.ElideRight
                        }
                    }
                }

                // =================================================
                // Empty / loading state
                // =================================================

                Label {
                    anchors.centerIn:
                        parent

                    width:
                        parent.width - 20

                    text:
                            root.controller !== null &&
                        root.controller.loadingAlbum
                        ? qsTr("Загрузка альбома...")
                        : qsTr("В альбоме нет треков")

                    color:
                        "#666666"

                    font.pixelSize:
                        13

                    horizontalAlignment:
                        Text.AlignHCenter

                    visible:
                        root.controller !== null &&
                        (
                            root.controller.loadingAlbum ||
                            tracksView.count === 0
                        )
                }
            }
        }
    }

    function formatDuration(milliseconds) {
        if (
            !milliseconds ||
            milliseconds <= 0
        ) {
            return "0:00"
        }

        var totalSeconds =
            Math.floor(
                milliseconds / 1000
            )

        var minutes =
            Math.floor(
                totalSeconds / 60
            )

        var seconds =
            totalSeconds % 60

        return minutes +
            ":" +
            (
                    seconds < 10
                    ? "0"
                    : ""
            ) +
            seconds
    }
}